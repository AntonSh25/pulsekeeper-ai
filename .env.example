# Copy to .env and fill locally. Do not commit real secrets.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional long-polling state. Runtime code should persist the next offset.
TELEGRAM_UPDATE_OFFSET=

# Local storage root. Telegram users are stored under ./data/users/<telegram_user_id>/health.jsonl
PULSEKEEPER_STORAGE_DIR=./data

# BYOK LLM config — user supplies their own provider key
LLM_PROVIDER=openai
LLM_API_KEY=

# Legacy single-user JSONL path for local CLI experiments
PULSEKEEPER_LOG_PATH=./health_log.jsonl
