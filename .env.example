# Copy to .env next to config.toml and fill locally. Do not commit real secrets.

# Telegram bot token from @BotFather (used when [telegram].enabled = true)
TELEGRAM_BOT_TOKEN=

# BYOK LLM provider key. Match [llm].api_key_env in config.toml.
OPENAI_API_KEY=

# Optional: override with your provider-specific env var and set llm.api_key_env accordingly.
# OPENROUTER_API_KEY=
